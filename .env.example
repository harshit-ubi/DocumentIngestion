# Application Settings
PROJECT_NAME="Document Ingestion Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Relational Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/document_ingestion_db"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/document_ingestion_db"

# AWS Configuration (Bedrock & AWS Services)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v1"

# Vector Stores Configuration
DEFAULT_VECTOR_STORE="pgvector"

# OpenSearch Serverless (AOSS) Config
AOSS_HOST=""
AOSS_INDEX_NAME="document-embeddings"

# AWS S3 Vector Store Config
S3_VECTOR_BUCKET=""
